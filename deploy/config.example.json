{
  "log_file": "/var/log/nginx/access.log",
  "database_path": "/var/lib/antiddos/antiddos.sqlite",
  "start_position": "end",
  "engine": {
    "ignore_ips": [],
    "rules": [
      {
        "id": "homepage",
        "path_regex": "^/$",
        "window": "5s",
        "threshold": 5,
        "group_by": "ip"
      }
    ]
  }
}

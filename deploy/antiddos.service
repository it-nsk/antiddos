[Unit]
Description=AntiDDoS access log analyzer
After=local-fs.target nftables.service iptables.service

[Service]
Type=simple
User=antiddos
Group=antiddos
Environment=ANTIDDOS_CONFIG=/etc/antiddos/config.json
EnvironmentFile=-/etc/default/antiddos
ExecStart=/usr/local/bin/antiddos launch
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
# nftables needs CAP_NET_ADMIN. The iptables set matcher also opens an IPv4
# raw socket to resolve an ipset name, so it additionally needs CAP_NET_RAW.
# launch drops each capability that the effective backend does not require.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
# The daemon validates whitelist edits and atomically replaces only its config.
ReadWritePaths=/etc/antiddos
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictSUIDSGID=true
# iptables/ipset's set matcher opens an IP socket while resolving the set.
# Keep netlink control restricted, but permit the families required by both
# nftables and the legacy iptables/ipset backend.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
StateDirectory=antiddos
StateDirectoryMode=0700
RuntimeDirectory=antiddos
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target

[Unit]
Description=AntiDDoS access log analyzer
After=local-fs.target

[Service]
Type=simple
User=antiddos
Group=antiddos
Environment=ANTIDDOS_CONFIG=/etc/antiddos/config.json
EnvironmentFile=-/etc/default/antiddos
ExecStart=/usr/local/bin/antiddos run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=antiddos
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target

[Unit]
Description=AntiDDoS access log analyzer
After=local-fs.target nftables.service

[Service]
Type=simple
User=antiddos
Group=antiddos
Environment=ANTIDDOS_CONFIG=/etc/antiddos/config.json
EnvironmentFile=-/etc/default/antiddos
ExecStart=/usr/local/bin/antiddos launch
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
# Effective nftables rules need host firewall access; launch otherwise drops it.
# CAP_NET_ADMIN is broad network administration access, not set-specific.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
# The daemon validates whitelist edits and atomically replaces only its config.
ReadWritePaths=/etc/antiddos
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StateDirectory=antiddos
StateDirectoryMode=0700
RuntimeDirectory=antiddos
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target

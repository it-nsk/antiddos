[Unit]
Description=AntiDDoS access log analyzer (legacy systemd)
After=local-fs.target iptables.service

[Service]
Type=simple
# systemd before v229 cannot grant AmbientCapabilities to a non-root service.
# Keep the daemon root only on those legacy systems; Group=antiddos preserves
# access to the web-control socket for the antiddos-web account.
User=root
Group=antiddos
Environment=ANTIDDOS_CONFIG=/etc/antiddos/config.json
Environment=ANTIDDOS_LEGACY_SYSTEMD=1
EnvironmentFile=-/etc/default/antiddos
ExecStart=/usr/local/bin/antiddos launch
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETPCAP CAP_DAC_OVERRIDE CAP_FOWNER
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadWriteDirectories=/etc/antiddos
RuntimeDirectory=antiddos
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target

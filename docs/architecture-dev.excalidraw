    {
      "id": "a0000091",
      "type": "text",
      "x": 579,
      "y": 1245,
      "width": 427,
      "height": 121,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "5b",

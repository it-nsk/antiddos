    {
      "id": "a0000126",
      "type": "text",
      "x": 2164,
      "y": 1790,
      "width": 1002,
      "height": 246,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "7e",
      "roundness": null,
      "seed": 17262,
      "version": 1,
      "versionNonce": 125622,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791774976419,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 2,
      "text": "CLI не получает CAP_NET_ADMIN и не запускает nft напрямую. Запрос принимает только локальный сокет с проверкой полномочий вызывающего процесса; сам Manager в daemon выполняет одно разрешённое действие над точным IP. Конфиг и текущий whitelist пока применяются перезапуском службы.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CLI не получает CAP_NET_ADMIN и не запускает nft напрямую. Запрос принимает только локальный сокет с проверкой полномочий вызывающего процесса; сам Manager в daemon выполняет одно разрешённое действие над точным IP. Конфиг и текущий whitelist пока применяются перезапуском службы.",
      "autoResize": true,
      "lineHeight": 1.25
    },

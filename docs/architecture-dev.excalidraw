    },
    {
      "id": "a0000120",
      "type": "text",
      "x": 764,
      "y": 1790,
      "width": 592,
      "height": 246,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

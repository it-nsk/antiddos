      "isDeleted": false,
      "boundElements": null,
      "updated": 1791774976419,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "log_file — Nginx access.log.\ndatabase_path — SQLite.\nstart_position — end / beginning.\nengine.ignore_ips — IP/CIDR (DNS имена не разрешаются), пустой список [].\nengine.rules: path_regex, window, threshold, group_by.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "log_file — Nginx access.log.\ndatabase_path — SQLite.\nstart_position — end / beginning.\nengine.ignore_ips — IP/CIDR (DNS имена не разрешаются), пустой список [].\nengine.rules: path_regex, window, threshold, group_by.",
      "autoResize": true,
      "lineHeight": 1.25
    },

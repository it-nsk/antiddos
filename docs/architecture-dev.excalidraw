      "fontFamily": 2,
      "text": "Whitelist и Engine",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Whitelist и Engine",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a0000055",
      "type": "text",
      "x": 1624,
      "y": 490,
      "width": 462,
      "height": 91,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

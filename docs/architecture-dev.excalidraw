      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "sudoedit /etc/antiddos/config.json\nsudo systemctl restart antiddos\nУстановщик сохраняет существующий конфиг, поэтому настройки обновляют вручную и затем перезапускают daemon.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sudoedit /etc/antiddos/config.json\nsudo systemctl restart antiddos\nУстановщик сохраняет существующий конфиг, поэтому настройки обновляют вручную и затем перезапускают daemon.",
      "autoResize": true,
      "lineHeight": 1.25
    },

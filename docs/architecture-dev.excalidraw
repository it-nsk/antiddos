      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 2,
      "text": "app передаёт обнаруженное нарушение Manager. Manager владеет policy, активными lease, Action и обновлением storage. app остаётся сборщиком компонентов и жизненного цикла.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "app передаёт обнаруженное нарушение Manager. Manager владеет policy, активными lease, Action и обновлением storage. app остаётся сборщиком компонентов и жизненного цикла.",
      "autoResize": true,
      "lineHeight": 1.25
    },

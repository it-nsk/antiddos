      "isDeleted": false,
      "boundElements": null,
      "updated": 1791774976419,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "path_regex — путь, например ^/$; window — длительность скользящего окна; threshold — число запросов; group_by — ровно одно поле. IP/CIDR whitelist глобальный для всех правил. Поздние события исключаются из окон, но помечаются в сервисной статистике.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "path_regex — путь, например ^/$; window — длительность скользящего окна; threshold — число запросов; group_by — ровно одно поле. IP/CIDR whitelist глобальный для всех правил. Поздние события исключаются из окон, но помечаются в сервисной статистике.",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "originalText": "3. Ручное снятие",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a0000123",
      "type": "text",
      "x": 1444,
      "y": 1790,
      "width": 632,
      "height": 246,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "7b",
      "roundness": null,
      "seed": 16851,
      "version": 1,
      "versionNonce": 122631,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791774976419,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 2,
      "text": "Команда antiddos unblock IP отправляет локальный запрос через Unix-сокет. Manager проверяет адрес, вызывает Action.Remove и обновляет SQLite. Повторный запрос для уже снятого IP — безопасный результат already_absent.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Команда antiddos unblock IP отправляет локальный запрос через Unix-сокет. Manager проверяет адрес, вызывает Action.Remove и обновляет SQLite. Повторный запрос для уже снятого IP — безопасный результат already_absent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
